{
  "name": "jonbaldie/explicitness-checker",
  "description": "A tool to analyze explicitness of PHP code (implicit inputs/outputs).",
  "type": "library",
  "keywords": [
    "php",
    "static-analysis",
    "code-quality",
    "functional-programming",
    "explicitness",
    "implicit-dependencies"
  ],
  "homepage": "https://github.com/jonbaldie/explicitness-checker",
  "support": {
    "issues": "https://github.com/jonbaldie/explicitness-checker/issues",
    "source": "https://github.com/jonbaldie/explicitness-checker"
  },
  "authors": [
    {
      "name": "Jonathan Baldie",
      "email": "jon@jonbaldie.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "nikic/php-parser": "^5.0"
  },
  "bin": [
    "bin/explicitness-checker"
  ],
  "license": "MIT",
  "minimum-stability": "stable",
  "require-dev": {
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "JonBaldie\\ExplicitnessChecker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JonBaldie\\ExplicitnessChecker\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.0.30"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "phpmd": "phpmd bin/explicitness-checker text phpmd.xml --suffixes ''",
    "infection": [
      "sh tools/install-infection.sh",
      "php tools/infection.phar --threads=max"
    ]
  }
}
