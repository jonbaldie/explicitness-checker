#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * explicitness-checker: reports implicit inputs and outputs in PHP functions
 * and methods. See README.md for flags, severities and exit codes.
 *
 * Usage:
 *   explicitness-checker [-v|--verbose] [--strict] [--props] [--exclude=dir]
 *     [--include-pattern=pattern] [--exclude-pattern=pattern]
 *     [--min-explicitness=percent] /path/to/project
 *
 * The command lives in JonBaldie\ExplicitnessChecker\Cli\Application; this
 * script only finds the autoloader and hands over the arguments.
 */

use JonBaldie\ExplicitnessChecker\Cli\Application;

// Try to find autoload.php in different locations
$autoloadPaths = [
    __DIR__ . "/../vendor/autoload.php", // Local development
    __DIR__ . "/../../../autoload.php", // Installed via Composer
];

$autoloadFound = false;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require_once $path;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    fwrite(
        STDERR,
        "Error: Could not find vendor/autoload.php. Please run 'composer install'.\n",
    );
    exit(1);
}

// Read $_SERVER['argv'] rather than $argv: static analysis can't assume $argv
// exists, because that depends on the register_argc_argv ini setting.
$cliArguments = $_SERVER["argv"] ?? [];
exit((new Application(STDOUT, STDERR))->run(
    is_array($cliArguments) ? array_values(array_filter($cliArguments, "is_string")) : [],
));
